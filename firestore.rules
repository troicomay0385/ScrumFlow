rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// ScrumFlow — Firestore Security Rules (Cập nhật chuẩn đầy đủ)
//
// Cấu trúc Collections:
//   1. users/{userId}                      — Hồ sơ người dùng
//   2. projects/{projectId}                — Thông tin dự án (Project)
//   3. projects/{projectId}/userStories    — Subcollection User Stories trong Backlog
//   4. projects/{projectId}/sprints        — Subcollection Sprints trong Dự án
//   5. projectMembers/{projectId_userId}   — Thành viên & Vai trò (PO / SM / MEMBER)
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. HÀM BỔ TRỢ (HELPERS) ─────────────────────────────────────

    // Kiểm tra người dùng đã đăng nhập chưa
    function isSignedIn() {
      return request.auth != null;
    }

    // Tạo ID chuẩn cho document membership: '<projectId>_<userId>'
    function memberDocId(projectId, userId) {
      return projectId + '_' + userId;
    }

    // Tạo reference tới document membership
    function membershipDoc(projectId, userId) {
      return /databases/$(database)/documents/projectMembers/$(memberDocId(projectId, userId));
    }

    // Kiểm tra user hiện tại có phải thành viên (PO, SM hoặc MEMBER) của project không
    function isProjectMember(projectId) {
      return isSignedIn() && exists(membershipDoc(projectId, request.auth.uid));
    }

    // Lấy vai trò (role) của user hiện tại trong project
    function currentRole(projectId) {
      return get(membershipDoc(projectId, request.auth.uid)).data.role;
    }

    // Kiểm tra user có phải Product Owner (PO) không
    function isPO(projectId) {
      return isProjectMember(projectId) && currentRole(projectId) == 'PO';
    }

    // Quyền quản lý Backlog (User Story): PO và SM
    function canManageBacklog(projectId) {
      return isProjectMember(projectId) && currentRole(projectId) in ['PO', 'SM'];
    }

    // Quyền quản lý Sprint: PO và SM
    function canManageSprint(projectId) {
      return isProjectMember(projectId) && currentRole(projectId) in ['PO', 'SM'];
    }

    // Kiểm tra tính hợp lệ của User Story
    function isValidStory(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.priority in ['CAO', 'TB', 'THẤP']
        && data.get('tags', []) is list
        && data.get('tags', []).size() <= 10;
    }

    // Kiểm tra vai trò hợp lệ
    function isValidRole(role) {
      return role in ['PO', 'SM', 'MEMBER'];
    }

    // ── 2. USERS COLLECTION ─────────────────────────────────────────
    match /users/{userId} {
      // Cho phép mọi người dùng đã đăng nhập đọc hồ sơ công khai của nhau
      allow read: if isSignedIn();

      // Chỉ chính user mới được tạo hồ sơ cho mình
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId;

      // Chỉ chính user mới được sửa hồ sơ của mình (không đổi ID)
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id;

      allow delete: if false;
    }

    // ── 3. PROJECTS COLLECTION ──────────────────────────────────────
    match /projects/{projectId} {
      // Tất cả thành viên trong dự án đều được đọc thông tin project
      allow read: if isProjectMember(projectId);

      // Mọi người dùng đăng nhập đều được tạo project mới
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == projectId;

      // Chỉ PO mới được sửa thông tin project
      allow update: if isPO(projectId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.id == resource.data.id;

      // Người tạo có quyền xóa project (để rollback khi cần)
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // ── Subcollection: userStories (Backlog) ──────────────────────
      match /userStories/{storyId} {
        // Mọi thành viên project đều đọc được danh sách User Story
        allow read: if isProjectMember(projectId);

        // PO và SM có quyền tạo mới User Story
        allow create: if canManageBacklog(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
          && isValidStory(request.resource.data);

        // PO và SM có quyền cập nhật User Story
        allow update: if canManageBacklog(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && isValidStory(request.resource.data);

        // PO và SM có quyền xóa User Story
        allow delete: if canManageBacklog(projectId);
      }

      // ── Subcollection: sprints (Sprint Management) ────────────────
      match /sprints/{sprintId} {
        // Mọi thành viên project đều đọc được danh sách Sprint
        allow read: if isProjectMember(projectId);

        // PO và SM có quyền tạo Sprint mới
        allow create: if canManageSprint(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.goal is string
          && request.resource.data.goal.size() > 0
          && request.resource.data.storyIds is list;

        // PO và SM có quyền cập nhật Sprint (thêm story, đổi mục tiêu, trạng thái)
        allow update: if canManageSprint(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && request.resource.data.storyIds is list;

        // PO và SM có quyền xóa Sprint
        allow delete: if canManageSprint(projectId);
      }
    }

    // ── 4. PROJECT MEMBERS COLLECTION ──────────────────────────────
    match /projectMembers/{membershipId} {
      // Thành viên trong project hoặc chính mình được đọc thông tin membership
      allow read: if isSignedIn()
        && (resource == null
          || request.auth.uid == resource.data.userId
          || isProjectMember(resource.data.projectId));

      // Tạo membership mới: User tự tạo quyền PO khi mới lập project HOẶC PO thêm thành viên
      allow create: if isSignedIn()
        && membershipId == memberDocId(request.resource.data.projectId, request.resource.data.userId)
        && isValidRole(request.resource.data.role)
        && (
          (
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.role == 'PO' &&
            get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.createdBy == request.auth.uid
          ) ||
          isPO(request.resource.data.projectId)
        );

      // Đổi role: Chỉ PO mới có quyền đổi role, không được tự đổi role của chính mình
      allow update: if isPO(resource.data.projectId)
        && request.auth.uid != resource.data.userId
        && isValidRole(request.resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

      // Xóa thành viên: Chỉ PO mới có quyền xóa thành viên, không tự xóa chính mình
      allow delete: if isPO(resource.data.projectId)
        && request.auth.uid != resource.data.userId;
    }

    // ── 5. TASKS COLLECTION ─────────────────────────────────────────
    // Tasks được lưu ở top-level collection, chứa storyId để link về User Story.
    // Để xác định quyền, ta tìm ngược projectId qua storyId.
    // Để đơn giản và nhanh gọn, mọi user đã đăng nhập đều có thể
    // đọc/ghi tasks (kiểm soát mịn hơn ở tầng app logic).
    match /tasks/{taskId} {
      // Mọi user đã đăng nhập đều đọc được task
      allow read: if isSignedIn();

      // Mọi user đã đăng nhập đều tạo được task mới
      allow create: if isSignedIn()
        && request.resource.data.storyId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['To Do', 'In Progress', 'Done'];

      // Mọi user đã đăng nhập đều cập nhật được task (kéo thả trạng thái)
      allow update: if isSignedIn()
        && request.resource.data.storyId == resource.data.storyId
        && request.resource.data.status in ['To Do', 'In Progress', 'Done'];

      // Chỉ người tạo task mới được xóa (kiểm tra createdBy nếu có)
      allow delete: if isSignedIn();
    }

    // ── 6. NOTIFICATIONS COLLECTION ─────────────────────────────────
    match /notifications/{notificationId} {
      // User đọc được thông báo gửi cho chính mình
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // User đăng nhập được tạo thông báo (bắn thông báo cho người khác hoặc chính mình)
      allow create: if isSignedIn();

      // User cập nhật thông báo của chính mình (đánh dấu đã đọc)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;

      // User xóa thông báo của chính mình
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
